    Reduce::Accumulable
      simple_aggrs[0]=(0, 0, sum(case when ((#0 = "2-HIGH") OR (#0 = "1-URGENT")) then 1 else 0 end))
      simple_aggrs[1]=(1, 1, sum(case when ((#0 != "2-HIGH") AND (#0 != "1-URGENT")) then 1 else 0 end))
      val_plan
        project=(#2, #3)
        map=(case when ((#0 = "2-HIGH") OR (#0 = "1-URGENT")) then 1 else 0 end, case when ((#0 != "2-HIGH") AND (#0 != "1-URGENT")) then 1 else 0 end)
      key_plan
        project=(#1)
      Join::Linear
        linear_stage[0]
          closure
            project=(#2, #1)
          lookup={ relation=0, key=[#0] }
          stream={ key=[#0], thinning=(#1) }
        source={ relation=1, key=[#0] }
        ArrangeBy
          raw=true
          arrangements[0]={ key=[#0], permutation=id, thinning=(#1) }
          types=[integer, char(15)]
          Get::Collection materialize.public.orders
            raw=true
        ArrangeBy
          raw=true
          arrangements[0]={ key=[#0], permutation=id, thinning=(#1) }
          types=[integer, char(10)]
          Get::Collection materialize.public.lineitem
            raw=true

