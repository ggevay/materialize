query T multiline
-- Query 04
EXPLAIN PHYSICAL PLAN WITH(humanized expressions, arity, join implementations) AS VERBOSE TEXT FOR
SELECT
    o_orderpriority,
    count(*) AS order_count
FROM
    orders
WHERE
    o_orderdate >= DATE '1993-07-01'
    AND o_orderdate < DATE '1993-07-01' + INTERVAL '3' month
    AND EXISTS (
        SELECT
            *
        FROM
            lineitem
        WHERE
            l_orderkey = o_orderkey
            AND l_commitdate < l_receiptdate
    )
GROUP BY
    o_orderpriority
ORDER BY
    o_orderpriority;
----
Explained Query:
  Finish order_by=[#0 asc nulls_last] output=[#0, #1]
    Reduce::Accumulable
      simple_aggrs[0]=(0, 0, count(*))
      val_plan
        project=(#1)
        map=(true)
      key_plan=id
      Join::Linear
        linear_stage[0]
          closure
            project=(#1)
          lookup={ relation=0, key=[#0] }
          stream={ key=[#0], thinning=() }
        source={ relation=1, key=[#0] }
        ArrangeBy
