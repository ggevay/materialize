query T multiline
-- Query 03
EXPLAIN PHYSICAL PLAN WITH(humanized expressions, arity, join implementations) AS VERBOSE TEXT FOR
SELECT
    l_orderkey,
    sum(l_extendedprice * (1 - l_discount)) AS revenue,
    o_orderdate,
    o_shippriority
FROM
    customer,
    orders,
    lineitem
WHERE
    c_mktsegment = 'BUILDING'
    AND c_custkey = o_custkey
    AND l_orderkey = o_orderkey
    AND o_orderdate < DATE '1995-03-15'
    AND l_shipdate > DATE '1995-03-15'
GROUP BY
    l_orderkey,
    o_orderdate,
    o_shippriority
ORDER BY
    revenue DESC,
    o_orderdate;
----
Explained Query:
  Finish order_by=[#1 desc nulls_first, #2 asc nulls_last] output=[#0..=#3]
    Mfp
      project=(#0, #3, #1, #2)
      input_key=#0..=#2
      Reduce::Accumulable
        simple_aggrs[0]=(0, 0, sum((#3 * (1 - #4))))
        val_plan
          project=(#5)
          map=((#3 * (1 - #4)))
        key_plan
          project=(#0..=#2)
        Join::Delta
          plan_path[0]
            delta_stage[1]
              lookup={ relation=2, key=[#0] }
              stream={ key=[#0], thinning=(#1, #2) }
            delta_stage[0]
              closure
                project=(#1..=#3)
              lookup={ relation=1, key=[#1] }
              stream={ key=[#0], thinning=() }
            source={ relation=0, key=[#0] }
          plan_path[1]
            delta_stage[1]
              lookup={ relation=2, key=[#0] }
              stream={ key=[#0], thinning=(#1, #2) }
            delta_stage[0]
              closure
                project=(#1..=#3)
              lookup={ relation=0, key=[#0] }
              stream={ key=[#1], thinning=(#0, #2, #3) }
            source={ relation=1, key=[#0] }
          plan_path[2]
            delta_stage[1]
              closure
                project=(#1..=#5)
              lookup={ relation=0, key=[#0] }
              stream={ key=[#1], thinning=(#0, #2..=#5) }
            delta_stage[0]
              closure
                project=(#0, #3..=#5, #1, #2)
              lookup={ relation=1, key=[#0] }
              stream={ key=[#0], thinning=(#1, #2) }
            source={ relation=2, key=[#0] }
          ArrangeBy
            raw=true
            arrangements[0]={ key=[#0], permutation=id, thinning=() }
            types=[integer]
            Get::Collection materialize.public.customer
              raw=true
          ArrangeBy
            raw=true
            arrangements[0]={ key=[#0], permutation=id, thinning=(#1..=#3) }
            arrangements[1]={ key=[#1], permutation={#0: #1, #1: #0}, thinning=(#0, #2, #3) }
            types=[integer, integer, date, integer]
            Get::Collection materialize.public.orders
              raw=true
          ArrangeBy
            raw=true
            arrangements[0]={ key=[#0], permutation=id, thinning=(#1, #2) }
            types=[integer, numeric, numeric]
            Get::Collection materialize.public.lineitem
              raw=true

Source materialize.public.customer
