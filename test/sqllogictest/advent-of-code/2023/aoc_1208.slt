# https://github.com/MaterializeInc/advent-of-code-2023/blob/main/week1/aoc_1208.md

mode cockroach

statement ok
CREATE TABLE steps_input (input TEXT);

statement ok
CREATE TABLE paths (state TEXT, left TEXT, right TEXT);

# no data

query T multiline
EXPLAIN PHYSICAL PLAN WITH(humanized expressions, arity, join implementations) AS VERBOSE TEXT FOR
WITH MUTUALLY RECURSIVE
    route(step TEXT, steps INT) AS (
        SELECT substring(input, steps, 1), steps
        FROM steps_input, generate_series(1, length(input)) steps
    ),

    -- Part 1: Start at 'AAA` and go until `ZZZ`.
    pos1(state TEXT, steps INT) AS (
        SELECT 'AAA', 0
        UNION ALL
        SELECT
            CASE WHEN route.step = 'L' THEN paths.left
                 WHEN route.step = 'R' THEN paths.right
                 ELSE '???'
            END,
            pos1.steps + 1
        FROM paths, pos1, route
        WHERE pos1.state = paths.state
          AND 1 + (pos1.steps % 263) = route.steps
          AND pos1.state != 'ZZZ'
          AND pos1.state != '???'
    ),
    part1(part1 INT) AS (SELECT steps FROM pos1 WHERE pos1.state = 'ZZZ'),

    -- Part 2: Start at all '**A` and go until all at '**Z'
    pos2(start TEXT, state TEXT, steps INT) AS (
        SELECT state, state, 0
        FROM paths
        WHERE substring(state, 3, 1) = 'A'
        UNION ALL
        SELECT
            pos2.start,
            CASE WHEN route.step = 'L' THEN paths.left
                 WHEN route.step = 'R' THEN paths.right
                 ELSE '???'
            END,
            pos2.steps + 1
        FROM paths, pos2, route
        WHERE pos2.state = paths.state
          AND 1 + (pos2.steps % 263) = route.steps
          AND substring(pos2.state, 3, 1) != 'Z'
    )

SELECT * FROM pos2 WHERE substring(state, 3, 1) = 'Z';
----
Explained Query:
  With Mutually Recursive
    cte l0 =
      Union
        Get::Collection materialize.public.paths
          project=(#0, #0, #4)
          filter=(("A" = #3))
          map=(0)
          raw=true
        Join::Delta
          plan_path[0]
            delta_stage[1]
              closure
                project=(#3, #7, #5)
                map=(case when (#6 = "L") then #1 else case when (#6 = "R") then #2 else "???" end end)
              lookup={ relation=2, key=[#0] }
              stream={ key=[(1 + (#3 % 263))], thinning=(#0..=#4) }
            delta_stage[0]
              closure
                project=(#1..=#5)
                map=((#4 + 1))
              lookup={ relation=1, key=[#1] }
              stream={ key=[#0], thinning=(#1, #2) }
            source={ relation=0, key=[#0] }
          plan_path[1]
            delta_stage[1]
              closure
                project=(#3, #7, #5)
                map=(case when (#6 = "L") then #1 else case when (#6 = "R") then #2 else "???" end end)
              lookup={ relation=2, key=[#0] }
              stream={ key=[(1 + (#3 % 263))], thinning=(#0..=#4) }
            delta_stage[0]
              closure
                project=(#4, #5, #1..=#3)
              lookup={ relation=0, key=[#0] }
              stream={ key=[#1], thinning=(#0, #2, #3) }
            initial_closure
              project=(#1, #0, #2, #3)
              map=((#2 + 1))
            source={ relation=1, key=[#1] }
          plan_path[2]
            delta_stage[1]
              closure
                project=(#1, #6, #3)
                map=(case when (#2 = "L") then #4 else case when (#2 = "R") then #5 else "???" end end)
              lookup={ relation=0, key=[#0] }
              stream={ key=[#1], thinning=(#0, #2, #3) }
            delta_stage[0]
              closure
                project=(#2, #3, #1, #5)
                map=((#4 + 1))
              lookup={ relation=1, key=[(1 + (#2 % 263))] }
              stream={ key=[#0], thinning=(#1) }
            source={ relation=2, key=[#0] }
          ArrangeBy
            raw=true
            arrangements[0]={ key=[#0], permutation=id, thinning=(#1, #2) }
            types=[text, text?, text?]
            Get::Collection materialize.public.paths
              project=(#0..=#2)
              filter=(("Z" != #3))
              raw=true
          ArrangeBy
            raw=true
            arrangements[0]={ key=[#1], permutation={#0: #1, #1: #0}, thinning=(#0, #2) }
            arrangements[1]={ key=[(1 + (#2 % 263))], permutation={#0: #1, #1: #2, #2: #3}, thinning=(#0..=#2) }
            types=[text, text, integer]
            Get::Collection l0
              filter=(("Z" != substr(#1, 3, 1)))
              raw=true
          ArrangeBy
            raw=true
            arrangements[0]={ key=[#0], permutation=id, thinning=(#1) }
            types=[integer, text?]
            FlatMap generate_series(1, char_length(#0), 1)
              mfp_after
                project=(#1, #2)
                map=(substr(#0, #1, 1))
              Get::PassArrangements materialize.public.steps_input
                raw=true
  Return
    Get::Collection l0
      filter=(("Z" = substr(#1, 3, 1)))
      raw=true

Source materialize.public.steps_input
Source materialize.public.paths
  project=(#0..=#3)
  map=(substr(#0{state}, 3, 1))

Target cluster: quickstart

