          closure
            project=(#3, #0, #4, #2, #5, #1)
          lookup={ relation=1, key=[#1..=#3] }
          stream={ key=[#1, (#2 + 1), #3], thinning=(#0, #2) }
        source={ relation=0, key=[#1, (#2 + 1), #3] }
        ArrangeBy
          raw=true
          arrangements[0]={ key=[#1, (#2 + 1), #3], permutation={#0: #3, #1: #0, #2: #4, #3: #2}, thinning=(#0, #2) }
          types=[integer?, integer, integer?, integer]
          Get::Collection l0
            project=(#0..=#3)
            filter=((#1) IS NOT NULL AND (#4 <= 21) AND (#4 > #3))
            raw=true
        ArrangeBy
          raw=true
          arrangements[0]={ key=[#1..=#3], permutation={#0: #3, #1: #0, #2: #1, #3: #2}, thinning=(#0) }
